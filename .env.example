# The public origin (scheme + host, no trailing slash). Embedded in the OAuth
# client_id and dist/client-metadata.json, so it must match the deployed host.
VITE_PUBLIC_URL=https://minori.example.com

# Base path. Leave unset ("/") for Cloudflare / custom-domain roots. For a
# GitHub Pages project site set it to "/<repo>/" (the deploy workflow sets this
# automatically). The OAuth client_id / redirect_uri include this path.
# VITE_BASE=/Minori/
